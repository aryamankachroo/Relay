# Clerk development keys: copy from your Clerk dashboard into .env.local.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Server-only secret: never add a VITE_ prefix. Never commit a real key.
CLERK_SECRET_KEY=sk_test_replace_me
# Relay API base URL. Leave empty for http://127.0.0.1:8000.
VITE_API_URL=
# Public Mapbox token for the Neighborhood map. Create one at
# https://account.mapbox.com/ and allow your dev and production URLs.
# Never commit a real token.
VITE_MAPBOX_ACCESS_TOKEN=
