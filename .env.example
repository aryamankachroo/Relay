# Clerk development keys: copy from your Clerk dashboard into .env.local.
VITE_CLERK_PUBLISHABLE_KEY=
# Server-only secret: never add a VITE_ prefix.
CLERK_SECRET_KEY=
# Relay API base URL. Leave empty for http://127.0.0.1:8000.
VITE_API_URL=

# Photon bridge: server-only credentials for .env.
PROJECT_ID=e625fb91-b9b4-4f77-ab29-dae692a66063
PROJECT_SECRET=

# Optional: seed your real sender handles into the fictional demo community.
DEMO_USER_PHONE=
DEMO_SECOND_PHONE=
DEMO_THIRD_PHONE=
# Persistent store; delete this local file only to deliberately reset the demo.
RELAY_STORE_PATH=.relay/state.json
RELAY_TIME_ZONE=America/New_York
RELAY_ZONE_LIMIT=1
# Optional parsing fallback only; matching/status decisions never use AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
