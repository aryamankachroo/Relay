# Backend only. Copy this file to backend/.env and fill it in there.
# Do not put frontend keys here. Those belong in .env.local at the repo root.
# Never commit backend/.env.
# Clerk secret key from the Clerk dashboard (starts with sk_). The browser session
# token is sent automatically. Do not paste a session token here.
CLERK_SECRET_KEY=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=
SNOWFLAKE_ROLE=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
BACKBOARD_API_KEY=
BACKBOARD_MODEL=gemini-2.5-flash
