{
  "name": "relay",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "dev:lan": "react-router dev --host",
    "build": "react-router typegen && tsc -b && react-router build",
    "lint": "eslint .",
    "test:unit": "node --experimental-strip-types --test src/api/coverage.test.ts",
    "test:spa": "node --test scripts/serve-client.test.mjs",
    "test:e2e": "playwright test",
    "preview": "node scripts/serve-client.mjs",
    "start": "node scripts/serve-client.mjs",
    "ios": "npm run build && cap sync ios && cap open ios"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@clerk/react-router": "^3.6.33",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "@rive-app/react-webgl2": "^4.36.0",
    "@tailwindcss/vite": "^4.3.3",
    "isbot": "^5",
    "lucide-react": "^1.55.0",
    "mapbox-gl": "^3.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.45",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@react-router/dev": "^7.18.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
